rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Project Validation ---
    
    function isValidProject(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.authorId == request.auth.uid &&
             data.xpReward is number && data.xpReward >= 0 && data.xpReward <= 1000;
    }

    match /projects/{projectId} {
      allow read: if true; // Public gallery
      allow create: if isSignedIn() && isValidProject(incoming()) && isValidId(projectId);
      allow update: if isSignedIn() && isOwner(existing().authorId) && 
                      isValidProject(incoming()) &&
                      incoming().authorId == existing().authorId &&
                      incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isOwner(existing().authorId);
    }

    // --- Build Validation ---
    
    function isValidBuild(data) {
      return data.projectId is string && 
             data.userId == request.auth.uid &&
             data.submissionImageUrl is string &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /builds/{buildId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || 
                     exists(/databases/$(database)/documents/projects/$(resource.data.projectId)));
      
      allow create: if isSignedIn() && isValidBuild(incoming()) && 
                      incoming().status == 'pending' &&
                      incoming().qualityScore == 0 &&
                      incoming().xpAwarded == 0 &&
                      exists(/databases/$(database)/documents/projects/$(incoming().projectId));
      
      // Updates are restricted. Only System/Admins should update scores.
      // For now, users can't update their own builds to prevent cheating.
      allow update: if false; 
    }
  }
}
